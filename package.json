{
  "name": "leetkob",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeeTKOB — C++ Lab Constraint Review, TA Review Queue, and Grade Publishing Gate",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "contract": "node --test --test-reporter=spec \"test/contract/**/*.test.js\"",
    "scan": "node scripts/scan-secrets.js",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run contract && npm run scan"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.3"
  }
}
