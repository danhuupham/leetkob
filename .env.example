# Server & Runtime Environment
NODE_ENV=development
PORT=3007
DATABASE_URL=:memory:
SESSION_SECRET=

# LLM Constraint Checker (Server-side only — never exposed to browser or sandbox)
# Provider hard spending cap: $5.00 USD/month configured in Google AI Studio / Cloud Billing
# Per-lab cost cap: $0.25 USD (~$0.012 estimated for 80 Accepted C++ submissions on Gemini 2.5 Flash)
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
MODEL_API_KEY=
MODEL_MAX_COST_USD_PER_LAB=0.25
MODEL_TIMEOUT_MS=10000

# C++ Judge Sandbox Minimums (Class Brief §5 & FAQ-05 — never receives MODEL_API_KEY)
SANDBOX_IMAGE=gcc:13.3-bookworm
SANDBOX_COMPILER_CMD=g++ -std=c++17 -O2
SANDBOX_COMPILE_TIMEOUT_MS=10000
SANDBOX_CPU_TIME_LIMIT_SEC=1
SANDBOX_WALL_TIME_LIMIT_SEC=3
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_PIDS_LIMIT=16
SANDBOX_OUTPUT_LIMIT_BYTES=1048576
SANDBOX_MAX_CODE_BYTES=65536
